generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model comment {
  id            Int      @id @default(autoincrement())
  content       String
  userId        Int
  restaurantId  Int?
  touristSpotId Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime

  @@index([restaurantId], map: "Comment_restaurantId_fkey")
  @@index([touristSpotId], map: "Comment_touristSpotId_fkey")
  @@index([userId], map: "Comment_userId_fkey")
}

model favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  placeId   Int
  createdAt DateTime @default(now())

  @@unique([userId, placeId], map: "Favorite_userId_placeId_key")
}

model gastronomy {
  id          Int             @id @default(autoincrement())
  name        String
  description String
  imageUrl    String
  city        gastronomy_city
}

model restaurant {
  id          Int             @id @default(autoincrement())
  name        String
  description String
  city        restaurant_city
  address     String
  phone       String?
  website     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime
}

model restaurantimage {
  id           Int    @id @default(autoincrement())
  url          String
  restaurantId Int

  @@index([restaurantId], map: "RestaurantImage_restaurantId_fkey")
}

model touristspot {
  id          Int              @id @default(autoincrement())
  name        String
  description String
  city        touristspot_city
  type        touristspot_type
  canFavorite Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
}

model touristspotimage {
  id            Int    @id @default(autoincrement())
  url           String
  touristSpotId Int

  @@index([touristSpotId], map: "TouristSpotImage_touristSpotId_fkey")
}

model user {
  id          Int       @id @default(autoincrement())
  name        String
  email       String    @unique(map: "User_email_key")
  password    String
  avatarUrl   String?   @db.VarChar(500)
  avatarColor String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  role        user_role @default(USER)
}

enum touristspot_city {
  CARAGUATATUBA
  UBATUBA
  SAO_SEBASTIAO
  ILHABELA
}

enum restaurant_city {
  CARAGUATATUBA
  UBATUBA
  SAO_SEBASTIAO
  ILHABELA
}

enum touristspot_type {
  PRAIA
  URBANO
  NATUREZA
}

enum gastronomy_city {
  CARAGUATATUBA
  UBATUBA
  SAO_SEBASTIAO
  ILHABELA
}

enum user_role {
  USER
  ADMIN
}
